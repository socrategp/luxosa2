# Copy to .env.local and fill in real values. Never commit .env.local.

# GHL Private Integration token (Contact read/write, Contact Notes,
# conversations/message write). All scopes needed, including email send,
# are confirmed working end to end — see server/luxosaTest/ghlClient.ts.
GHL_PRIVATE_INTEGRATION_TOKEN=

# GHL sub-account (location) the Luxosa Test writes to.
GHL_LOCATION_ID=

# "test" restricts every GHL write to the sandbox Contact
# (server/luxosaTest/ghlClient.ts SANDBOX_CONTACT_ID) regardless of what the
# browser sends. Unset or any other value = production write behavior.
LUXOSA_TEST_MODE=test

# REQUIRED whenever LUXOSA_TEST_MODE=test — the only email TEST MODE is
# authorized to use/target. If a submitted email doesn't match this
# (normalized) value, the request is refused (TEST_IDENTITY_NOT_ALLOWED,
# HTTP 403) before any GHL/email side effect; if this var itself is unset,
# every submission fails closed (BLOCKED_TEST_CONFIG_MISSING). See
# server/luxosaTest/submission.ts.
LUXOSA_TEST_SANDBOX_EMAIL=

# Durable ledger + distributed lock + rate limiter, all backed by Upstash
# Redis (server/luxosaTest/redisClient.ts). Deliberately NOT Redis.fromEnv()
# — that only recognizes UPSTASH_REDIS_REST_URL/TOKEN or KV_REST_API_URL/
# TOKEN, neither of which matches the Vercel-generated names below.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# Ledger storage provider (server/luxosaTest/ledger.ts). getLedger() prefers
# Redis automatically whenever the two vars above are set. This fallback is
# NOT durable across serverless invocations and is refused outright on
# Vercel (VERCEL=1) — local/dev testing only, and only when Redis isn't
# configured.
LUXOSA_LEDGER_PROVIDER=memory-dev-only

# Optional rate-limit overrides (server/luxosaTest/rateLimit.ts). Defaults
# shown — uncomment to change.
# LUXOSA_RATE_LIMIT_WINDOW_SECONDS=60
# LUXOSA_RATE_LIMIT_MAX_REQUESTS=10
